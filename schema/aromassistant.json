    {
      "id": "tblxdBzpsu0dwSlBD",
      "name": "Drop Calculator",
      "slug": "drop-calculator",
      "primaryFieldId": "fldQx6d9gG1MXwzxO",
      "fields": [
        {
          "id": "fldQx6d9gG1MXwzxO",
          "name": "Directions",
          "type": "singleLineText",
          "description": "The first row in this table calculates the number of drops for a blend given the size of container and % dilution. The remaining rows allow the user to choose an oil in the \"Which oil? column to see the maximum dilution rate for the oil and check for the maximum number of drops."
        },
        {
          "id": "fld9yKSOS9fbewuYx",
          "name": "Dilution Recommendations",
          "type": "multilineText"
        },
        {
          "id": "fld60FoDark0zlBVj",
          "name": "Choose unit: (mL or oz)...",
          "type": "singleSelect",
          "config": {
            "choices": [
              {
                "id": "selbC1hKyFB7T1sc6",
                "name": "mL",
                "color": "blueLight2"
              },
              {
                "id": "selSEKatLYTk5esNl",
                "name": "oz",
                "color": "cyanLight2"
              }
            ]
          }
        },
        {
          "id": "fld9aPBklNYyZDyhO",
          "name": "How much are you making?",
          "type": "number",
          "config": {
            "precision": 2
          }
        },
        {
          "id": "fldjaoTU354QB8kob",
          "name": "What is your dilution %?",
          "type": "number",
          "description": "1% - Children 2+, pregnant/nursing, elderly, immunocompromised\n2% - Healthy adult\n3% - Acute use: short-term and small area\nHigher percentages should be used with caution and only under special circumstances.",
          "config": {
            "precision": 2
          }
        },
        {
          "id": "fldOZS9caJxbipsUB",
          "name": "This is your # of drops:",
          "type": "formula",
          "config": {
            "isValid": true,
            "formula": "IF({fld60FoDark0zlBVj} = \"mL\", ({fld9aPBklNYyZDyhO} * {fldjaoTU354QB8kob}) * .2,({fld9aPBklNYyZDyhO} * {fldjaoTU354QB8kob}) * 6) + 0",
            "referencedFieldIds": [
              "fld60FoDark0zlBVj",
              "fld9aPBklNYyZDyhO",
              "fldjaoTU354QB8kob"
            ],
            "result": {
              "type": "number",
              "options": {
                "precision": 1
              }
            }
          }
        }
      ]
    },
